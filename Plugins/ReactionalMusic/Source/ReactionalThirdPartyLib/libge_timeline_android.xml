<?xml version="1.0" encoding="utf-8"?>
<!--Reactional android additions-->
<root xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- init section is always evaluated once per architecture -->
	<init>
		<log text="ReactionalMusic ge_timeline Init"/>
		<setBool result="bCopySoFileToDevice" value="true"/>
		<setBool result="bSupported" value="false"/>
        	<isArch arch="arm64-v8a">
			<setBool result="bSupported" value="true"/>
			<setBool result="bCopySoFileToDevice" value="true"/>
		</isArch>
	</init>

	<!-- optional files or directories to copy to Intermediate/Android/APK -->
	<resourceCopies>
		<isArch arch="arm64-v8a">
			<if condition="bCopySoFileToDevice">
				<true>
					<log text="Reactional: Adding libge_timeline.so to Intermediate/Android/APK"/>
					<copyFile src="$S(PluginDir)/libge_timeline.so"
								dst="$S(BuildDir)/libs/arm64-v8a/libge_timeline.so" />
				</true>
			</if>
		</isArch>
	</resourceCopies>

	<!-- optional libraries to load in GameActivity.java before libUnreal.so -->
	<soLoadLibrary>
		<!-- need this if plugin enabled and supported architecture, even if not packaged for Oculus mobile -->
		<if condition="bSupported">
			<true>
				<if condition="bCopySoFileToDevice">
					<true>
						<loadLibrary name="ge_timeline" failmsg="ge_timeline not loaded." />
					</true>
				</if>
			</true>
		</if>
	</soLoadLibrary>
</root>
